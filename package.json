{
  "name": "dfwlfront-7",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:replay": "esbuild scripts/test-replay.ts --bundle --platform=node --format=esm --outfile=.tmp/test-replay.mjs && node .tmp/test-replay.mjs",
    "test:migration": "esbuild scripts/test-migration.ts --bundle --platform=node --format=esm --outfile=.tmp/test-migration.mjs && node .tmp/test-migration.mjs",
    "test:smoke": "esbuild scripts/smoke-dom.ts --bundle --platform=node --format=esm --outfile=.tmp/smoke.mjs --external:jsdom --external:vite && node .tmp/smoke.mjs",
    "test:smoke-migration": "esbuild scripts/test-migration-dom.ts --bundle --platform=node --format=esm --outfile=.tmp/test-mig-dom.mjs --external:jsdom --external:vite && node .tmp/test-mig-dom.mjs",
    "test": "npm run test:replay && npm run test:migration && npm run test:smoke && npm run test:smoke-migration"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.7",
    "leaflet": "^1.9.4",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "vue-tsc": "^3.3.11"
  }
}
